# recast.obligations — dispositions for every `allium plan` obligation
# derived from recast.allium (plan/0146 P1). Lanes: `structural` the
# spec's own check/analyse lane; `kani:` the Rust core's #[cfg(kani)]
# harnesses; `test:` the named cargo test discharging it in CI. The P2
# hf-side obligations stand; P3 (the repack tier) landed the
# RepackByteParity block below; recast-over-GGUF tiers remain waived
# until the full gguf-recast retirement (P4).

# -- config defaults: one test reads the binary's constants
config-default.fp16_half_range => test:config_defaults
config-default.fp16_max => test:config_defaults
config-default.rescale_target => test:config_defaults
config-default.min_scale => test:config_defaults

# -- enums and entity fields: the type system, discharged structurally
enum-comparable.Band => structural
enum-comparable.Tier => structural
enum-comparable.ArtifactFormat => structural
entity-fields.TorchCast => structural
entity-fields.GgufRecast => structural
entity-fields.TensorRecord => structural
entity-fields.RecastRun => structural
entity-fields.PipelineInvocation => structural

# -- the band law: Kani lane, universal over bit patterns
invariant.TensorRecord.BandTotallyClassified => kani:band_totally_classified

# -- P3 pure-logic Kani harnesses (pack laws) and fp laws
invariant.gn.UnpackReproducesNibbles => kani:unpack_reproduces_every_nibble
invariant.gn.VReorderIsAPermutation => kani:v_reorder_is_a_permutation
invariant.gn.TransposeInvolutive => kani:transpose_involutive
invariant.f16.UpcastExact => test:f16_upcast_exact_over_domain
invariant.f16.ExpTableAgreement => test:f16_exp_agrees_with_bf16_table_in_range

# -- run lifecycle: behavioural, the CLI tests
transition-edge.RecastRun.running.completed => test:run_lifecycle_completes
transition-edge.RecastRun.running.halted => test:run_lifecycle_halts
transition-rejected.RecastRun.status => test:exit_codes_distinct
transition-terminal.RecastRun.status => structural

# -- rules: the tier dispatch table, one test per tier
rule-success.InvokeRecast => test:gate_cli_invocation
rule-entity-creation.InvokeRecast.1 => test:gate_cli_invocation
rule-success.ClassifyTensor => test:census_classifies_every_tensor
rule-success.BuildCensus => test:census_completeness
rule-success.CompleteRun => test:run_lifecycle_completes
rule-failure.CompleteRun.1 => test:run_lifecycle_completes
rule-success.HaltRun => test:run_lifecycle_halts
rule-failure.HaltRun.1 => test:run_lifecycle_halts
rule-success.T1Dispatch => test:t1_dispatch
rule-failure.T1Dispatch.1 => test:t1_dispatch
rule-success.RescaleTiers => test:t2_t3_rescale
rule-failure.RescaleTiers.1 => test:t2_t3_rescale
rule-success.T4RecordsScalesOnly => test:t4_records_scales_only
rule-failure.T4RecordsScalesOnly.1 => test:t4_records_scales_only
rule-success.T5Hadamard => test:t5_hadamard
rule-failure.T5Hadamard.1 => test:t5_hadamard
rule-success.DryRunWritesNothing => test:dry_run_writes_nothing
rule-failure.DryRunWritesNothing.1 => test:dry_run_writes_nothing
rule-success.ExitCodeSignalsDeviation => test:exit_code_signals_deviation
rule-failure.ExitCodeSignalsDeviation.1 => test:exit_code_signals_deviation

# -- contracts: the core cast is Kani's, the parity gates are tests
contract-signature.SelectiveRecast.recast => kani:normal_range_bit_exact
contract-signature.SelectiveRecast.hf_parity => test:torch_parity_bitwise
contract-signature.GgufByteParity.parity => waived: recast-over-GGUF tiers (t1-t5 on GGUF artifacts) remain un-ported; the P3 window blocker landed the repack path instead, its parity is RepackByteParity below; this disposition retires with the full gguf-recast retirement (P4)

# -- P3 repack tier (call/0039, window blocker for plan/0147); the ids
#    below are allium plan's derived set for the RepackRun constructs.
entity-fields.RepackRun => structural
transition-edge.RepackRun.running.completed => test:trunk_byte_identical_to_oracle
transition-edge.RepackRun.running.halted => test:repack_rejects_non_autoround
transition-rejected.RepackRun.status => structural
transition-terminal.RepackRun.status => structural
rule-success.InvokeRepack => test:trunk_byte_identical_to_oracle
rule-entity-creation.InvokeRepack.1 => test:trunk_byte_identical_to_oracle
rule-success.ValidateAutoRoundShape => test:trunk_byte_identical_to_oracle
rule-failure.ValidateAutoRoundShape.1 => test:repack_rejects_non_autoround
rule-success.RejectInvalidCheckpoint => test:repack_rejects_non_autoround
rule-failure.RejectInvalidCheckpoint.1 => test:trunk_byte_identical_to_oracle
rule-success.EmitRepackArtifact => test:trunk_byte_identical_to_oracle
rule-success.SpliceMtpFromRecast => test:splice_path
rule-failure.SpliceMtpFromRecast.1 => test:splice_rejects_export_with_mtp
rule-failure.SpliceMtpFromRecast.2 => test:splice_rejects_dir_without_mtp
contract-signature.RepackByteParity.parity => test:trunk_byte_identical_to_oracle + test:real_ar_byte_identical
invariant.RepackByteParity.TrunkByteIdenticalToIncumbent => test:trunk_byte_identical_to_oracle
invariant.RepackByteParity.Fp16ExportAccepted => test:f16_keeper_export_repacks
invariant.RepackRun.NoVReorderMetadata => test:no_v_reorder_metadata_keys

# -- surface: the gate CLI
surface-actor.GateCLI => test:gate_cli_invocation
surface-exposure.GateCLI => test:census_tsv_schema
surface-provides.GateCLI => test:gate_cli_invocation
